{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dgb-dataset:DGBCase:v1",
  "title": "DGBCase/v1 with verified RoBAS resource snapshots",
  "description": "结构和来源记录约束，非工程设计合理性或RoBAS求解通过的证明。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_schema_version",
    "case_id",
    "case_title",
    "case_family",
    "scenario_type",
    "data_origin",
    "design_intent",
    "scenario_description",
    "initial_user_request",
    "reference_brief",
    "robas_catalog_evidence",
    "validation",
    "dialogue_refs"
  ],
  "properties": {
    "dataset_schema_version": {
      "const": "DGBCase/v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^DGB-[0-9]{4,}$"
    },
    "case_title": {
      "type": "string",
      "minLength": 1
    },
    "case_family": {
      "const": "single_row_deep_groove_ball"
    },
    "scenario_type": {
      "const": "single_steady_state"
    },
    "data_origin": {
      "const": "synthetic_scenario_with_verified_robas_catalog_records"
    },
    "design_intent": {
      "type": "string"
    },
    "scenario_description": {
      "type": "string"
    },
    "initial_user_request": {
      "type": "string",
      "minLength": 1
    },
    "reference_brief": {
      "$ref": "#/$defs/brief"
    },
    "robas_catalog_evidence": {
      "type": "object",
      "required": [
        "archive_sha256",
        "model",
        "materials",
        "lubricants",
        "reference_geometry",
        "clearance_warning"
      ],
      "properties": {
        "archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "type": "object",
          "required": [
            "matched_row",
            "exact_catalog_match"
          ],
          "properties": {
            "source_path": {
              "type": "string"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "table": {
              "const": "model"
            },
            "matched_row": {
              "type": "object",
              "required": [
                "model",
                "d_mm",
                "D_mm",
                "B_mm"
              ],
              "properties": {
                "model": {
                  "type": "string"
                },
                "d_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "D_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "B_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "exact_catalog_match": {
              "const": true
            }
          }
        },
        "materials": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/snapshot"
          }
        },
        "lubricants": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/snapshot"
          }
        },
        "reference_geometry": {
          "type": "object"
        },
        "clearance_warning": {
          "type": "object"
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "schema_valid",
        "robas_model_record_matched",
        "robas_material_records_matched",
        "robas_lubricant_records_matched",
        "engineering_reviewed",
        "robas_solver_verified",
        "status"
      ],
      "properties": {
        "schema_valid": {
          "const": true
        },
        "robas_model_record_matched": {
          "const": true
        },
        "robas_material_records_matched": {
          "const": true
        },
        "robas_lubricant_records_matched": {
          "const": true
        },
        "engineering_reviewed": {
          "type": "boolean"
        },
        "robas_solver_verified": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "CATALOG_VERIFIED_ENGINEERING_PENDING",
            "ENGINEERING_REVIEWED",
            "SOLVER_VERIFIED",
            "INCOMPLETE"
          ]
        }
      }
    },
    "unmapped_user_facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dialogue_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^DIALOGUE-DGB-[0-9]{4,}-[A-Z]$"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "confirmed",
        "precision",
        "source"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "object",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmed": {
          "type": "boolean"
        },
        "precision": {
          "enum": [
            "exact",
            "approximate",
            "range",
            "unknown"
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "user",
                "not_provided",
                "catalog",
                "reviewed_rule",
                "derived"
              ]
            },
            "message_id": {
              "type": "string",
              "minLength": 1
            },
            "simulation": {
              "type": "boolean"
            },
            "ref": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "catalog_match": {
          "type": "object",
          "required": [
            "file",
            "key_column",
            "key_value",
            "verified",
            "source_sha256"
          ],
          "properties": {
            "resource": {
              "const": "RoBAS"
            },
            "file": {
              "type": "string"
            },
            "key_column": {
              "type": "string"
            },
            "key_value": {
              "type": "string",
              "minLength": 1
            },
            "verified": {
              "type": "boolean"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "properties": {
              "confirmed": {
                "const": false
              },
              "precision": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmed": {
                "const": true
              }
            },
            "required": [
              "confirmed"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              },
              "precision": {
                "not": {
                  "const": "unknown"
                }
              },
              "source": {
                "properties": {
                  "kind": {
                    "not": {
                      "const": "not_provided"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "brief": {
      "type": "object",
      "required": [
        "schema_version",
        "bearing",
        "dimensions",
        "operating",
        "engineering",
        "requirements",
        "optimization_slots",
        "solver_context",
        "delivery_state"
      ],
      "properties": {
        "schema_version": {
          "const": "DGBDesignBrief/v1"
        },
        "bearing": {
          "type": "object",
          "required": [
            "type",
            "application",
            "model"
          ],
          "properties": {
            "type": {
              "const": "DGB"
            },
            "application": {
              "allOf": [
                {
                  "$ref": "#/$defs/parameter"
                },
                {
                  "properties": {
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "unit": {
                      "type": "null"
                    }
                  }
                }
              ]
            },
            "model": {
              "allOf": [
                {
                  "$ref": "#/$defs/parameter"
                },
                {
                  "properties": {
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "unit": {
                      "type": "null"
                    }
                  }
                }
              ]
            }
          }
        },
        "dimensions": {
          "type": "object",
          "required": [
            "d_mm",
            "D_mm",
            "B_mm"
          ],
          "properties": {
            "d_mm": {
              "allOf": [
                {
                  "$ref": "#/$defs/parameter"
                },
                {
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0.001
                    },
                    "unit": {
                      "const": "mm"
                    }
                  }
                }
              ]
            },
            "D_mm": {
              "allOf": [
                {
                  "$ref": "#/$defs/parameter"
                },
                {
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0.001
                    },
                    "unit": {
                      "const": "mm"
                    }
                  }
                }
              ]
            },
            "B_mm": {
              "allOf": [
                {
                  "$ref": "#/$defs/parameter"
                },
                {
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0.001
                    },
                    "unit": {
                      "const": "mm"
                    }
                  }
                }
              ]
            }
          }
        },
        "operating": {
          "type": "object",
          "required": [
            "inner_speed_rpm",
            "outer_speed_rpm",
            "radial_load_n",
            "axial_load_n",
            "temperature_c"
          ],
          "properties": {
            "inner_speed_rpm": {
              "allOf": [
                {
                  "$ref": "#/$defs/parameter"
                },
                {
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "unit": {
                      "const": "rpm"
                    }
                  }
                }
              ]
            },
            "outer_speed_rpm": {
              "allOf": [
                {
                  "$ref": "#/$defs/parameter"
                },
                {
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "unit": {
                      "const": "rpm"
                    }
                  }
                }
              ]
            },
            "radial_load_n": {
              "allOf": [
                {
                  "$ref": "#/$defs/parameter"
                },
                {
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "unit": {
                      "const": "N"
                    }
                  }
                }
              ]
            },
            "axial_load_n": {
              "allOf": [
                {
                  "$ref": "#/$defs/parameter"
                },
                {
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "unit": {
                      "const": "N"
                    }
                  }
                }
              ]
            },
            "temperature_c": {
              "allOf": [
                {
                  "$ref": "#/$defs/parameter"
                },
                {
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": -273.15,
                      "maximum": 500
                    },
                    "unit": {
                      "const": "degC"
                    }
                  }
                }
              ]
            },
            "axial_load_direction": {
              "allOf": [
                {
                  "$ref": "#/$defs/parameter"
                },
                {
                  "properties": {
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "unit": {
                      "type": "null"
                    }
                  }
                }
              ]
            },
            "rotation_direction": {
              "allOf": [
                {
                  "$ref": "#/$defs/parameter"
                },
                {
                  "properties": {
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "unit": {
                      "type": "null"
                    }
                  }
                }
              ]
            },
            "mounting_orientation": {
              "allOf": [
                {
                  "$ref": "#/$defs/parameter"
                },
                {
                  "properties": {
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "unit": {
                      "type": "null"
                    }
                  }
                }
              ]
            }
          }
        },
        "engineering": {
          "type": "object",
          "required": [
            "materials",
            "cage",
            "lubrication",
            "clearance",
            "fits"
          ],
          "properties": {
            "materials": {
              "type": "object",
              "required": [
                "inner_ring_id",
                "outer_ring_id",
                "ball_id"
              ],
              "properties": {
                "inner_ring_id": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/parameter"
                    },
                    {
                      "properties": {
                        "value": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "unit": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                },
                "outer_ring_id": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/parameter"
                    },
                    {
                      "properties": {
                        "value": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "unit": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                },
                "ball_id": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/parameter"
                    },
                    {
                      "properties": {
                        "value": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "unit": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "cage": {
              "type": "object",
              "required": [
                "type",
                "material_id"
              ],
              "properties": {
                "type": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/parameter"
                    },
                    {
                      "properties": {
                        "value": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "unit": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                },
                "material_id": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/parameter"
                    },
                    {
                      "properties": {
                        "value": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "unit": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "lubrication": {
              "type": "object",
              "required": [
                "mode",
                "lubricant_id"
              ],
              "properties": {
                "mode": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/parameter"
                    },
                    {
                      "properties": {
                        "value": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "enum": [
                            "oil",
                            "grease",
                            "other",
                            null
                          ]
                        },
                        "unit": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                },
                "lubricant_id": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/parameter"
                    },
                    {
                      "properties": {
                        "value": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "unit": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "clearance": {
              "type": "object",
              "required": [
                "group",
                "initial_radial_clearance_mm"
              ],
              "properties": {
                "group": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/parameter"
                    },
                    {
                      "properties": {
                        "value": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "unit": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                },
                "initial_radial_clearance_mm": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/parameter"
                    },
                    {
                      "properties": {
                        "value": {
                          "oneOf": [
                            {
                              "type": "number",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            },
                            {
                              "type": "object",
                              "required": [
                                "min",
                                "max"
                              ],
                              "properties": {
                                "min": {
                                  "type": "number",
                                  "minimum": 0
                                },
                                "max": {
                                  "type": "number",
                                  "minimum": 0
                                }
                              }
                            }
                          ]
                        },
                        "unit": {
                          "const": "mm"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "fits": {
              "type": "object",
              "required": [
                "inner_ring",
                "outer_ring"
              ],
              "properties": {
                "inner_ring": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/parameter"
                    },
                    {
                      "properties": {
                        "value": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "unit": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                },
                "outer_ring": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/parameter"
                    },
                    {
                      "properties": {
                        "value": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "unit": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "requirements": {
          "type": "object",
          "required": [
            "constraints",
            "preferences",
            "geometric_bounds"
          ],
          "properties": {
            "constraints": {
              "type": "array"
            },
            "preferences": {
              "type": "array"
            },
            "geometric_bounds": {
              "type": "array"
            }
          }
        },
        "optimization_slots": {
          "type": "object",
          "required": [
            "Dw_mm",
            "Z",
            "Dpw_mm",
            "fi",
            "fo"
          ],
          "properties": {
            "Dw_mm": {
              "type": "object",
              "required": [
                "mode",
                "value",
                "bounds"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "optimize",
                    "locked",
                    "bounded"
                  ]
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0
                },
                "bounds": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "min",
                        "max"
                      ],
                      "properties": {
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": true,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "optimize"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "locked"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "number"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "bounded"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "bounds": {
                        "type": "object"
                      }
                    }
                  }
                }
              ]
            },
            "Z": {
              "type": "object",
              "required": [
                "mode",
                "value",
                "bounds"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "optimize",
                    "locked",
                    "bounded"
                  ]
                },
                "value": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "bounds": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "min",
                        "max"
                      ],
                      "properties": {
                        "min": {
                          "type": "integer"
                        },
                        "max": {
                          "type": "integer"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": true,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "optimize"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "locked"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "integer"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "bounded"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "bounds": {
                        "type": "object"
                      }
                    }
                  }
                }
              ]
            },
            "Dpw_mm": {
              "type": "object",
              "required": [
                "mode",
                "value",
                "bounds"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "optimize",
                    "locked",
                    "bounded"
                  ]
                },
